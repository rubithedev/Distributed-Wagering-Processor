{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true
  },
  "monorepo": true,
  "projects": {
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "wagering-worker": {
      "type": "application",
      "root": "apps/wagering-worker",
      "entryFile": "main",
      "sourceRoot": "apps/wagering-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/wagering-worker/tsconfig.app.json"
      }
    }
  }
}
